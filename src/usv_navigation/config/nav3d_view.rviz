Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /点云1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 2
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Reference Frame: camera_init
      Value: true

    # 3D 点云 (Point-LIO 配准点云, 立体感核心, 同 lio.sh 观感)
    # QoS 必须与 Point-LIO 发布一致 (Reliable), 否则收不到任何数据
    # Decay Time=30: 点累积显示30秒 (同 lio.sh 的累积观感), 不是单帧一闪
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: 3D点云 (LIO)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /cloud_registered
      Use Fixed Frame: true
      Use rainbow: true
      Decay Time: 30
      Color:
        Color: 255; 255; 255
        ColorTransformer: AxisColor     # 同 lio.sh 坐标轴着色
        Value: true
      Size (Pixels): 4
      Size (m): 0.05
      Style: Flat Squares
      Value: true

    # 船的轨迹 (Odometry 箭头, 世界系)
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 200
      Name: 船位置
      Shape:
        Alpha: 1
        Axes Length: 1.2
        Axes Radius: 0.1
        Color: 255; 25; 0
        Value: Axes
      Topic:
        Depth: 5
        Reliability Policy: Reliable
        Value: /aft_mapped_to_init
      Value: true

    # 全局路径 (绕障的绿线)
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 230; 0
      Enabled: true
      Name: 全局路径
      Line Style: Lines
      Line Width: 0.15
      Topic:
        Depth: 5
        Reliability Policy: Reliable
        Value: /plan
      Value: true

    # 局部路径 (若有)
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 50; 120; 255
      Enabled: true
      Name: 局部路径
      Line Width: 0.1
      Topic:
        Depth: 5
        Reliability Policy: Reliable
        Value: /local_plan
      Value: true

    # costmap 底面 (帮助理解障碍在哪)。当前机器的 RViz/OpenGL 驱动会在
    # Map 插件创建 8-bit costmap 纹理时报告 GLSL sampler 冲突；该错误会
    # 让 3D 视图变黑/无响应。路径、点云和 3D 障碍方块不依赖该插件，先
    # 默认关闭；需要时可在 RViz Displays 面板中手动打开验证驱动状态。
    - Alpha: 0.35
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Enabled: false
      Name: 局部costmap底面
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Value: true

    # 3D 障碍方块 (新节点 costmap_3d_markers 发布, 立体显示障碍)
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 3D障碍方块
      Topic:
        Depth: 5
        Reliability Policy: Reliable
        Value: /obstacle_3d/markers
      Value: true

    # 点击导航点: 红色球保留到 Clear Markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 导航点标记 (红)
      Topic:
        Depth: 5
        Reliability Policy: Reliable
        Value: /nav_waypoints_markers
      Value: true

    # 船体轮廓
    - Class: rviz_default_plugins/Polygon
      Color: 0; 255; 100
      Enabled: true
      Name: 船体 footprint
      Topic:
        Depth: 5
        Reliability Policy: Reliable
        Value: /local_costmap/published_footprint
      Value: true

  Enabled: true
  Global Options:
    Background Color: 34; 36; 42
    Fixed Frame: camera_init
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive: false
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: nav2_rviz_plugins/GoalTool
      Capture modifiers: false
      Topic:
        Value: /goal_pose
    # Publish Point: 选中后在 3D 视图 Shift+左键点击 -> 发 /clicked_point
    # 我们会写个监听节点把 clicked_point 转成 Nav2 goal
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 60
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.1
      Target Frame: camera_init
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.785
    Saved: ~

Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Tool Properties:
    collapsed: false
  Width: 1500
  X: 0
  Y: 27
