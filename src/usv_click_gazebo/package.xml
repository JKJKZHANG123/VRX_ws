<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>usv_click_gazebo</name>
  <version>0.1.0</version>
  <description>
    Click-to-goal for the WAM-V: a gz-sim GUI plugin that publishes the 3D
    world coordinate of a left-click in the Gazebo scene, a ros_gz_bridge for
    that topic, and a ROS node that converts world -> odom and publishes
    /goal_pose for Nav2.
  </description>
  <maintainer email="jkjkzhang@todo.todo">jkjkzhang</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz-gui8</depend>
  <depend>gz-transport</depend>
  <depend>gz-msgs</depend>
  <depend>gz-plugin</depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>ros_gz_bridge</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
